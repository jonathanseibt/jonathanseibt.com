{
  "name": "steelnobre",
  "private": true,
  "author": {
    "name": "Jonathan Seibt",
    "email": "hey@jonathanseibt.com",
    "url": "https://jonathanseibt.com"
  },
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "24.x",
    "pnpm": "^10"
  },
  "scripts": {
    "prepare": "npx -y is-ci || npx skills experimental_install -y",
    "clear": "rm -rf **/node_modules && git clean -dfx -e '.env'",
    "kill-port": "sh -c 'lsof -ti tcp:$0 | xargs kill -9 2>/dev/null || true'",
    "dev": "pnpm kill-port 3000 && pnpm --filter @steelnobre/web dev",
    "build": "pnpm --filter @steelnobre/web build",
    "start": "pnpm kill-port 3000 && pnpm --filter @steelnobre/web start",
    "lint": "turbo run lint && pnpm lint:prettier",
    "lint:prettier": "prettier . --write --ignore-path .prettierignore --log-level error"
  },
  "devDependencies": {
    "@steelnobre/eslint-config": "workspace:*",
    "@steelnobre/typescript-config": "workspace:*",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "turbo": "^2.9.18"
  }
}
